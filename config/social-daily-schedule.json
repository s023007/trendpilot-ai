{
  "version": 1,
  "timezone": "Asia/Muscat",
  "strategy": "event-growth-daily",
  "start_date": "2026-08-20",
  "channels": {
    "pinterest": {
      "enabled": true,
      "posts_per_day": 4,
      "local_times": ["08:15", "13:15", "18:15", "21:15"],
      "utc_cron_times": ["04:15", "09:15", "14:15", "17:15"],
      "default_board": "Football Match & Travel Guides",
      "burst_on_manual_or_config_change": 3,
      "scheduled_batch_size": 1
    },
    "tiktok": {
      "enabled": true,
      "posts_per_day": 2,
      "local_times": ["12:30", "19:30"],
      "utc_cron_times": ["08:30", "15:30"],
      "format": "vertical-video",
      "duration_seconds": 10
    },
    "youtube": {
      "enabled": true,
      "posts_per_day": 1,
      "local_times": ["20:30"],
      "utc_cron_times": ["16:30"],
      "format": "shorts",
      "duration_seconds": 10,
      "category_id": "17"
    }
  },
  "rules": {
    "deduplicate_by_event_and_asset": true,
    "prefer_tier_a_events": true,
    "never_use_unrelated_pinterest_boards": true,
    "only_publish_verified_ready_events": true,
    "utm_source_per_channel": true
  }
}
