DirectoryIndex index.php index-v3.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^submit-request\.php$ submit-request-gmail.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.php|index-v3\.html|submit-request\.php|submit-request-gmail\.php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
